{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agents-core-system.schema.json",
  "title": "Agents foundation creation system",
  "type": "object",
  "required": ["schema", "purpose", "identity", "canonical", "runtime_local", "deploy_contract", "release_contract", "route_contract", "validation"],
  "properties": {
    "schema": {
      "const": "agents-core-system/v1"
    }
  },
  "x-required-paths": [
    "identity.name",
    "identity.version_source",
    "identity.release_name",
    "identity.system_type",
    "canonical.route_first",
    "canonical.version",
    "canonical.foundation_creation",
    "canonical.governance",
    "runtime_local.never_track_or_ship",
    "runtime_local.forbidden_payloads",
    "deploy_contract.source",
    "deploy_contract.required_evidence",
    "deploy_contract.exclude",
    "release_contract.source",
    "release_contract.manifest_fields",
    "route_contract.source",
    "route_contract.rule",
    "validation.profile"
  ],
  "x-required-values": [
    {
      "path": "identity.version_source",
      "value": ".agents/docs/agents/version.yaml"
    },
    {
      "path": "identity.release_name",
      "value": "Foundation Creation Layer"
    },
    {
      "path": "identity.system_type",
      "value": "repo-local AI workflow foundation"
    },
    {
      "path": "canonical.route_first",
      "value": ".agents/docs/agents/ai-runtime.yaml"
    },
    {
      "path": "deploy_contract.exclude",
      "value": "runtime_local.never_track_or_ship"
    },
    {
      "path": "validation.profile",
      "value": "core_system"
    }
  ],
  "x-required-contains": [
    {
      "path": "purpose",
      "contains": ["Foundation Creation Layer boundary"]
    },
    {
      "path": "canonical.foundation_creation",
      "contains": [".agents/docs/agents/openai-foundations.yaml"]
    },
    {
      "path": "route_contract.rule",
      "contains": ["Read ai-runtime first", "named route pack"]
    }
  ]
}
