{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "layout",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "agents-managed/v3"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "layout": {
      "enum": [
        "root-layout",
        "dot-agents-layout"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "path",
          "sha256"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
