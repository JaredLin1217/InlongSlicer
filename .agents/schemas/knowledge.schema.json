{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "type",
    "conclusion",
    "scope",
    "sources",
    "verified_utc",
    "verification",
    "status",
    "supersedes",
    "sensitive"
  ],
  "properties": {
    "schema_version": {
      "const": "agents-knowledge/v3"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "type": {
      "enum": [
        "fact",
        "decision",
        "lesson"
      ]
    },
    "conclusion": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "commit"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "commit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verified_utc": {
      "type": "string",
      "format": "date-time"
    },
    "verification": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "conflicted",
        "superseded"
      ]
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sensitive": {
      "const": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
