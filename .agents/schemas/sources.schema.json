{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "agents-sources/v3"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "checked",
          "refresh_interval_days",
          "next_review_due",
          "boundary",
          "drift_risk",
          "topics"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://(learn\\.chatgpt\\.com|developers\\.openai\\.com)/"
          },
          "checked": {
            "type": "string",
            "format": "date"
          },
          "refresh_interval_days": {
            "enum": [
              30,
              90
            ]
          },
          "next_review_due": {
            "type": "string",
            "format": "date"
          },
          "boundary": {
            "type": "string",
            "minLength": 1
          },
          "drift_risk": {
            "type": "string",
            "minLength": 1
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
