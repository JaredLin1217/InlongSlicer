{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "objective",
    "latest_adjustment",
    "boundaries",
    "completed",
    "open_issues",
    "next_steps",
    "source_commit",
    "updated_utc",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "agents-task/v3"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "latest_adjustment": {
      "type": "string",
      "minLength": 1
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_commit": {
      "type": "string",
      "minLength": 1
    },
    "updated_utc": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^([a-f0-9]{64}|missing)$"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
