# Included by CMakeLists, edited by the build script
# (the version numbers are generated by the build script from the git current label)

set(SLIC3R_APP_NAME "InlongSlicer")
set(SLIC3R_APP_DISPLAY_NAME "Inlong Slicer")
set(SLIC3R_APP_KEY "InlongSlicer")
set(SLIC3R_APP_CMD "inlong-slicer")
set(SLIC3R_APP_ID "io.github.JaredLin1217.InlongSlicer")

if(NOT DEFINED BBL_INTERNAL_TESTING)
set(BBL_INTERNAL_TESTING "0")
endif()
set(INLONGSLICER_VERSION "2.5.0-dev")
string(REGEX MATCH "^([0-9]+)\\.([0-9]+)\\.([0-9]+)"
       INLONGSLICER_VERSION_MATCH ${INLONGSLICER_VERSION})
set(INLONGSLICER_VERSION_MAJOR ${CMAKE_MATCH_1})
set(INLONGSLICER_VERSION_MINOR ${CMAKE_MATCH_2})
set(INLONGSLICER_VERSION_PATCH ${CMAKE_MATCH_3})

set(SLIC3R_VERSION "02.08.01.55")

if (NOT DEFINED INLONG_UPDATER_SIG_KEY)
    set(INLONG_UPDATER_SIG_KEY "" CACHE STRING "Base64url encoded updater signature key")
endif()
