  "changes": [
    {
      "component": "Polyline3 common linear and arc-enabled simplification",
      "invariant": "A closed source contour with at least three vertices is retained when linear simplification would leave fewer than three vertices. Valid fitted arcs retain their existing representation; fallback clears stale fitting metadata."
    },
    {
      "component": "Organic independent support output planner",
      "invariant": "Preserve bed support at or below the first object plane. When the first exact contact is closer than the minimum layer height, lower the independent support bed layer within the minimum limit. Leave object Z, exact contact Z, profiles and raft heights unchanged. Infeasible exact-anchor constraints retain the explicit synchronized fallback."
    }
  ],
  "device_independence": "Both fixes use geometry, configured tolerances and layer-height limits. No machine name, vendor identifier or per-device profile override selects either fix.",
  "parameterized_coverage": {
    "closed_contours": "3 geometric scales x 3 tolerances x arc on/off = 18 cases, plus open-line and valid arc controls",
    "support_planning": "5 nozzle scales (0.2/0.4/0.6/0.8/1.2) x 2 first heights x 4 contact separations x 2 body grid modes = 80 cases",
    "synthetic_pipeline": "3 nozzle diameters (0.4/0.6/0.8) x 2 independent-body modes = 6 tilted-model slices and G-code exports; every model first layer is empty but the real first support deposits material",
    "existing_support": "Traditional support, classic tree styles, organic contact continuity, raft preservation and infeasible-plan fallback covered by the affected native test selection"
  },
